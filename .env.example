# Copy to .env on the RU host, chmod 600, then fill the backend URL and token.
# Never commit .env or real credentials.
CONTROL_PLANE_URL=https://guard.example.com
# Must match the control plane's AGENT_TOKEN (32+ characters).
AGENT_TOKEN=

# Stable, unique ID for this RU worker. Runtime default: ru-1.
# Change on EVERY additional node, e.g. ru-spb-provider-2.
# Registration is automatic; no backend/pool changes are needed.
AGENT_ID=ru-1
# Path to the Xray executable bundled in the Docker image.
XRAY_BIN=/usr/local/bin/xray

# Comma-separated lists of 1-4 HTTPS URLs. Defaults match the Go worker.
# CONTROL_URLS are requested directly; PROBE_URLS through each VLESS tunnel.
CONTROL_URLS=https://ya.ru,https://www.cloudflare.com/cdn-cgi/trace
PROBE_URLS=https://www.gstatic.com/generate_204,https://cp.cloudflare.com/generate_204
# Only for deliberate local development. Leave false on a real RU host.
ALLOW_INSECURE_HTTP=false
